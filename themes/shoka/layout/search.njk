{% extends '_partials/layout.njk' %}
{% block title %}搜索 | {% endblock %}
{% block header %}<h1>搜索</h1><p class="meta">查找文章标题与正文</p>{% endblock %}
{% block content %}
<section class="page wrap search-page">
  <label for="search-input">搜索文章</label>
  <input id="search-input" type="search" placeholder="输入关键词" autocomplete="off" maxlength="100" disabled aria-describedby="search-status">
  <p id="search-status" role="status" aria-live="polite">正在加载文章…</p>
  <ul id="search-results" aria-label="搜索结果"></ul>
  <p><a href="{{ url_for('/archives/') }}">按归档浏览文章</a></p>
  <noscript><p>搜索需要 JavaScript，文章和归档可以直接阅读。</p><style>#search-input,#search-status{display:none}</style></noscript>
</section>
{% endblock %}
