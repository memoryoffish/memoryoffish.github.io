{% extends '_partials/layout.njk' %}
{% block title %}搜索 | {% endblock %}
{% block header %}<h1>搜索</h1><p class="meta">查找研究项目与个人介绍</p>{% endblock %}
{% block content %}
<section class="page wrap search-page">
  <label for="search-input">搜索研究项目与个人介绍</label>
  <input id="search-input" type="search" placeholder="输入关键词" autocomplete="off" maxlength="100" disabled aria-describedby="search-status">
  <p id="search-status" role="status" aria-live="polite">正在加载搜索内容…</p>
  <ul id="search-results" aria-label="搜索结果"></ul>
  <p><a href="{{ url_for('/projects/') }}">浏览研究项目</a></p>
  <noscript><p>搜索需要 JavaScript，项目页与个人介绍可以直接阅读。</p><style>#search-input,#search-status{display:none}</style></noscript>
</section>
{% endblock %}
