{% extends '_partials/layout.njk' %}
{% import '_macro/card.njk' as card with context %}
{% import '_macro/postmeta.njk' as postmeta with context %}
{% import '_macro/segment.njk' as segment with context %}

{% block header %}
  {% set profile = site.data.profile %}
  <div class="home-profile-hero">
    <h1 class="title profile-name">{{ alternate or title }}</h1>
    <p class="profile-author">{{ profile.name or author }}{% if profile.english_name %}<span>{{ profile.english_name }}</span>{% endif %}</p>
    {% if profile.education %}<p class="meta">{{ profile.education }}</p>{% endif %}
    {% if profile.research %}<p class="profile-research">{{ profile.research }}</p>{% endif %}
  </div>
{% endblock %}

{% block content %}
  <div class="index wrap">
    {% if page.current == 1 and site.data.profile %}
    <section class="bio-preview" aria-labelledby="bio-title">
      <h2 class="divider" id="bio-title">关于我</h2>
      <div class="bio-copy">
        {% for paragraph in site.data.profile.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
        <ul class="bio-links" aria-label="个人链接">
          {% for link in site.data.profile.links %}<li><a href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}
          <li><a href="{{ url_for('/about/') }}">更多关于我 →</a></li>
        </ul>
      </div>
    </section>
    {% endif %}

    {% if page.current == 1 and site.data.projects %}
    <section class="project-preview" aria-labelledby="projects-title">
      <h2 class="divider" id="projects-title"><a href="{{ url_for('/projects/') }}">项目</a></h2>
      <div class="project-preview-list">
      {% for project in site.data.projects %}
        <article>
          {% if project.thumbnail %}<img src="{{ url_for(project.thumbnail) }}" alt="{{ project.thumbnailAlt }}" width="160" height="100" loading="lazy">{% endif %}
          <div><h3>{{ project.title or project.name }}</h3>{% if project.kind %}<p class="project-meta"><strong>{{ project.kind }}</strong></p>{% endif %}<p>{{ project.description }}</p>
            {% if project.links %}<ul>{% for link in project.links %}<li><a href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}</ul>{% endif %}
          </div>
        </article>
      {% endfor %}
      </div>
    </section>
    {% endif %}

    {%- if page.current == 1 %}
      {%- if page.sticky.length > 0%}
      <h2 class="divider">{{ __('index.sticky') }}</h2>
      {%- set sticky = page.sticky.toArray() %}
      <div class="segments sticky">
        {%- for post in sticky %}
          {{ segment.render(post) }}
        {%- endfor %}
      </div>
      {%- endif %}

      {%- if page.catlist.length > 0%}
      <h2 class="divider">{{ __('index.category') }}</h2>
      <div class="cards">
        {%- for cat in page.catlist %}
          {{ card.render(cat) }}
        {%- endfor %}
      </div>
      {%- endif %}
    {%- endif %}

    {%- if page.posts.length > 0%}
    {%- set posts = page.posts.toArray() %}
    {%- if page.current == 1 %}
    <h2 class="divider">{{ __('index.posts') }}</h2>
    {%- endif %}
    <div class="segments posts">
      {%- for post in posts %}
        {{ segment.render(post) }}
      {%- endfor %}
    </div>
    {%- endif %}

  </div>

  {% include '_partials/pagination.njk' %}

{% endblock %}
