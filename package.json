{
  "name": "memoryoffish-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Original Shoka blog, restored with local lightweight assets",
  "scripts": {
    "build": "node tools/build.js",
    "serve": "hexo server --ip 127.0.0.1 --port 13131",
    "check": "node tools/test-renderer.cjs && npm run build && python3 tools/check-site.py"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-autoprefixer": "2.0.0",
    "hexo-fs": "5.0.1",
    "hexo-pagination": "4.0.0",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-util": "4.0.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-attrs": "5.0.1",
    "nunjucks": "3.2.4",
    "prismjs": "1.30.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-generator-category": "2.0.0"
  },
  "hexo": {
    "version": "8.1.2"
  }
}
